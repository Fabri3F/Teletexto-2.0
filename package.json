{
  "name": "teletexto-2-0",
  "version": "0.0.0",
  "private": true,
  "description": "Teletexto 2.0: plataforma web de información pública inspirada en el teletexto, para comunidades rurales del Perú.",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @teletexto/web",
    "build": "npm run build --workspace @teletexto/web",
    "preview": "npm run preview --workspace @teletexto/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
